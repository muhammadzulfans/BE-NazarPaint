generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER & STORE ====================

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  password  String
  jabatan   String      @default("MANAGEMENT")
  role      String      @default("KARYAWAN") // "OWNER" | "KARYAWAN"
  avatar    String?     @default("uploads/avatars/default.jpg")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  stores        UserStore[]
  sales         Sale[]
  purchases     Purchase[]
  mutationsFrom Mutation[]  @relation("MutationFrom")
  mutationsTo   Mutation[]  @relation("MutationTo")

  @@map("users")
}

model Store {
  id        String      @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users         UserStore[]
  stocks        Stock[]
  salesFrom     Sale[]
  purchasesFrom Purchase[]
  mutationsFrom Mutation[]  @relation("MutationStoreFrom")
  mutationsTo   Mutation[]  @relation("MutationStoreTo")

  @@map("stores")
}

model UserStore {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("user_stores")
}

// ==================== PRODUCT & STOCK ====================

model Product {
  id          String   @id @default(cuid())
  code        String   @unique // kode barang, contoh: 515, 210
  name        String           // nama barang, contoh: Silver, Red
  type        String           // "GLOSS" | "PRO" | "SUPER" | "ACCESSORIES"
  color       String?           // hex code, contoh: "#FFFFFF" — NEW
  basePrice   Int              // harga pokok (Rp)
  sellPrice   Int              // harga jual (Rp)
  unit        String   @default("Kg") // satuan: Kg, pcs, dll
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks        Stock[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  mutationItems MutationItem[]

  @@map("products")
}

// Stok per produk per cabang
model Stock {
  id        String   @id @default(cuid())
  productId String
  storeId   String
  quantity  Float    @default(0) // total stok dalam unit (Kg/pcs)
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId]) // 1 produk hanya punya 1 record stok per cabang
  @@map("stocks")
}

// ==================== PENJUALAN ====================

model Sale {
  id          String     @id @default(cuid())
  storeId     String
  userId      String     // kasir/karyawan yang input
  customerName String?   
  totalAmount Int        // total harga semua item
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  store       Store      @relation(fields: [storeId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  items       SaleItem[]

  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  quantity    Float    // jumlah terjual (Kg)
  sellPrice   Int      // harga jual saat transaksi (snapshot)
  totalPrice  Int      // quantity * sellPrice

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

// ==================== BELANJA / PEMBELIAN ====================

model Purchase {
  id          String         @id @default(cuid())
  storeId     String
  userId      String
  totalAmount Int
  status      String         @default("PENDING") // "PENDING" | "RECEIVED" | "CANCELLED"
  date        DateTime       @default(now())
  receivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store       Store          @relation(fields: [storeId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  items       PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  quantity    Float    // jumlah dibeli (Kg)
  basePrice   Int      // harga pokok saat beli (snapshot)
  totalPrice  Int      // quantity * basePrice

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ==================== MUTASI STOK ====================

model Mutation {
  id          String         @id @default(cuid())
  fromStoreId String         // cabang asal
  toStoreId   String         // cabang tujuan
  userId      String         // yang melakukan mutasi
  note        String?
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  fromStore   Store          @relation("MutationStoreFrom", fields: [fromStoreId], references: [id])
  toStore     Store          @relation("MutationStoreTo", fields: [toStoreId], references: [id])
  userFrom    User           @relation("MutationFrom", fields: [userId], references: [id])
  userTo      User?          @relation("MutationTo", fields: [receivedBy], references: [id])
  receivedBy  String?        // yang menerima mutasi (opsional)
  items       MutationItem[]

  @@map("mutations")
}

model MutationItem {
  id         String   @id @default(cuid())
  mutationId String
  productId  String
  quantity   Float

  mutation   Mutation @relation(fields: [mutationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("mutation_items")
}